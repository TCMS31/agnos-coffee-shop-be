# Copy to .env for local development. dotenv-rails loads it in development and
# test; in production these are supplied by the environment, not by a file.

# --- Database -------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=coffee_shop_development
TEST_DATABASE_NAME=coffee_shop_test
RAILS_MAX_THREADS=5

# --- Background jobs ------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Outbound mail --------------------------------------------------------
# Development delivers to tmp/letter_opener instead of sending; these matter in
# production. EMAIL_DEFAULT_ADDRESS falls back to no-reply@coffee-shop.example.
EMAIL_DEFAULT_ADDRESS=orders@your-coffee-shop.example
GMAIL_USERNAME=
GMAIL_PASSWORD=
HOST=localhost

# --- Rails ----------------------------------------------------------------
# Required in production; Rails refuses to boot without it.
# SECRET_KEY_BASE=
